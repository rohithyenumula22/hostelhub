							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"name\": \"Suresh Menon\",\n    \"email\": \"suresh.menon@email.com\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/residents",
