									"",
									"pm.test('Resident created successfully', function () {",
									"    const json = pm.response.json();",
									"    pm.expect(json.status).to.eql('success');",
									"    pm.expect(json.message).to.eql('Resident created successfully');",
									"    pm.expect(json.data).to.have.property('id');",
									"    pm.expect(json.data.name).to.eql('Suresh Menon');",
