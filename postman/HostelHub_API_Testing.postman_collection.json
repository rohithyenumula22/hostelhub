{
	"info": {
		"_postman_id": "hostelhub-api-testing-collection",
		"name": "HostelHub API Testing",
		"description": "Complete API test collection for HostelHub – Room Allotment Management System.\n\nBase URL: http://localhost:3000\n\nMake sure the server is running before testing:\n```\nnpm start\n```",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"variable": [
		{
			"key": "baseUrl",
			"value": "http://localhost:3000",
			"type": "string"
		}
	],
	"item": [
		{
			"name": "Rooms",
			"description": "CRUD operations for hostel rooms.",
			"item": [
				{
					"name": "1. Get All Rooms",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/rooms",
							"host": ["{{baseUrl}}"],
							"path": ["rooms"]
						},
						"description": "Returns all rooms in the database."
					},
					"event": [
						{
							"listen": "test",
							"script": {
								"type": "text/javascript",
								"exec": [
									"pm.test('Status code is 200', function () {",
									"    pm.response.to.have.status(200);",
									"});",
									"",
									"pm.test('Response has data array', function () {",
									"    const json = pm.response.json();",
									"    pm.expect(json.status).to.eql('success');",
									"    pm.expect(json.data).to.be.an('array');",
									"});",
									"",
									"pm.test('Each room has id, name, block', function () {",
									"    const rooms = pm.response.json().data;",
									"    if (rooms.length > 0) {",
									"        pm.expect(rooms[0]).to.have.property('id');",
									"        pm.expect(rooms[0]).to.have.property('name');",
									"        pm.expect(rooms[0]).to.have.property('block');",
									"    }",
									"});"
								]
							}
						}
					],
					"response": []
				},
				{
					"name": "2. Get Room by ID",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/rooms/1",
							"host": ["{{baseUrl}}"],
							"path": ["rooms", "1"]
						},
						"description": "Returns a single room by its ID."
					},
					"event": [
						{
							"listen": "test",
							"script": {
								"type": "text/javascript",
								"exec": [
									"pm.test('Status code is 200', function () {",
									"    pm.response.to.have.status(200);",
									"});",
									"",
									"pm.test('Response has correct room data', function () {",
									"    const json = pm.response.json();",
									"    pm.expect(json.status).to.eql('success');",
									"    pm.expect(json.data).to.have.property('id', 1);",
									"    pm.expect(json.data).to.have.property('name');",
									"    pm.expect(json.data).to.have.property('block');",
									"});"
								]
							}
						}
					],
					"response": []
				},
				{
					"name": "3. Add Room",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"name\": \"Room 301\",\n    \"block\": \"Block C\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/rooms",
							"host": ["{{baseUrl}}"],
							"path": ["rooms"]
						},
						"description": "Creates a new room with a name and block."
					},
					"event": [
						{
							"listen": "test",
							"script": {
								"type": "text/javascript",
								"exec": [
									"pm.test('Status code is 201', function () {",
									"    pm.response.to.have.status(201);",
									"});",
									"",
									"pm.test('Room created successfully', function () {",
									"    const json = pm.response.json();",
									"    pm.expect(json.status).to.eql('success');",
									"    pm.expect(json.message).to.eql('Room created successfully');",
									"    pm.expect(json.data).to.have.property('id');",
									"    pm.expect(json.data.name).to.eql('Room 301');",
									"    pm.expect(json.data.block).to.eql('Block C');",
									"});",
									"",
									"// Save the created room ID for later use",
									"if (pm.response.code === 201) {",
									"    pm.collectionVariables.set('createdRoomId', pm.response.json().data.id);",
									"}"
								]
							}
						}
					],
					"response": []
				},
				{
					"name": "4. Update Room",
					"request": {
						"method": "PUT",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"name\": \"Room 301-Updated\",\n    \"block\": \"Block C-Updated\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/rooms/{{createdRoomId}}",
							"host": ["{{baseUrl}}"],
							"path": ["rooms", "{{createdRoomId}}"]
						},
						"description": "Updates an existing room's name and block. Uses the room ID saved from 'Add Room'."
					},
					"event": [
						{
							"listen": "test",
							"script": {
								"type": "text/javascript",
								"exec": [
									"pm.test('Status code is 200', function () {",
									"    pm.response.to.have.status(200);",
									"});",
									"",
									"pm.test('Room updated successfully', function () {",
									"    const json = pm.response.json();",
									"    pm.expect(json.status).to.eql('success');",
									"    pm.expect(json.message).to.eql('Room updated successfully');",
									"    pm.expect(json.data.name).to.eql('Room 301-Updated');",
									"    pm.expect(json.data.block).to.eql('Block C-Updated');",
									"});"
								]
							}
						}
					],
					"response": []
				},
				{
					"name": "5. Delete Room",
					"request": {
						"method": "DELETE",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/rooms/{{createdRoomId}}",
							"host": ["{{baseUrl}}"],
							"path": ["rooms", "{{createdRoomId}}"]
						},
						"description": "Deletes an unallotted room. Uses the room ID saved from 'Add Room'."
					},
					"event": [
						{
							"listen": "test",
							"script": {
								"type": "text/javascript",
								"exec": [
									"pm.test('Status code is 204', function () {",
									"    pm.response.to.have.status(204);",
									"});"
								]
							}
						}
					],
					"response": []
				}
			]
		},
		{
